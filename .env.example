# ---------------------------------------------------------------------------
# Copy to `.env` for local experiments. Never commit `.env`.
#
# Only the Vercel function reads these three values. They must be added to the
# Vercel project as encrypted environment variables, not to GitHub secrets:
# the GitHub Actions workflows never call Spotify.
#
# Obtain them once with:
#   node scripts/spotify-auth.mjs
# ---------------------------------------------------------------------------

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Long-lived (until revoked) token produced by the helper above.
SPOTIFY_REFRESH_TOKEN=

# ---------------------------------------------------------------------------
# Optional, used by the GitHub asset generator.
# A classic PAT with `read:user` is enough for the GraphQL contribution
# calendar; without it the generator falls back to the public REST endpoints.
# ---------------------------------------------------------------------------
GITHUB_TOKEN=

# The account whose profile is being rendered.
GITHUB_LOGIN=ajaybe-ops
