{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/now-playing.js": {
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/api/now-playing",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
